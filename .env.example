# ==========================================
# MawaqetSalat.com Environment Configuration
# Copy this file to .env and fill in values.
# Never commit the real .env file.
# ==========================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://mawaqetsalat.com

# ── Analytics ──────────────────────────────
# Google Analytics 4 (verified from legacy WP: G-Z3189YVP04)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── AdSense ────────────────────────────────
# Publisher ID (verified from legacy WP: ca-pub-6331163447795368)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Ad slot IDs — one per placement (get from AdSense dashboard)
NEXT_PUBLIC_AD_SLOT_HEADER=
NEXT_PUBLIC_AD_SLOT_AFTER_PT=
NEXT_PUBLIC_AD_SLOT_AFTER_CITIES=
NEXT_PUBLIC_AD_SLOT_FOOTER=

# ── Database ───────────────────────────────
# PostgreSQL connection string (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mawaqetsalat?sslmode=disable

# ── Optional / Phase 4+ ────────────────────
# AlAdhan API fallback (not used by default — adhan library handles calculations)
ALADHAN_API_BASE_URL=https://api.aladhan.com/v1
